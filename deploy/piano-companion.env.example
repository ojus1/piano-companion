# Copy to backend/.env on the Pi to override defaults (see backend/src/piano_companion/config.py).
# PC_MIDI_INPUT=Digital Piano        # substring of the ALSA port name; "auto" = first non-"Through" port
# PC_SESSION_IDLE_SECONDS=90
# PC_AUDIO_ENABLED=true              # record the piano's AUX OUT through the USB audio interface
# PC_AUDIO_DEVICE=USB Audio CODEC    # substring of the device name from: python -m sounddevice
